{
    "name": "landtech/bhumishield-backend",
    "type": "project",
    "description": "ভূমি সুরক্ষা (BhumiShield) — Laravel 11 REST API Backend for LandTech Innovation Hackathon 2026",
    "keywords": ["laravel", "bhumishield", "landtech", "ed25519", "hash-chain"],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/"
        },
        "classmap": [
            "database/migrations"
        ],
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
