# BhumiShield ("ভূমি সুরক্ষা") — Demo Environment Configuration
# Dummy data only. No live government systems are called.

POSTGRES_USER=bhumishield
POSTGRES_PASSWORD=bhumishield_demo_2026
POSTGRES_DB=bhumishield

# Use PostgreSQL in Docker Compose, or SQLite locally for zero-config evaluation
DATABASE_URL=postgresql://bhumishield:bhumishield_demo_2026@localhost:5432/bhumishield
SQLITE_FALLBACK_PATH=./bhumishield_demo.db

# JWT Authentication
JWT_SECRET=bhumishield-landtech-2026-demo-jwt-secret-key-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Ed25519 Registrar Signing Seed (32-byte hex seed for deterministic demo signatures)
REGISTRAR_ED25519_SEED_HEX=4268756d69536869656c644c616e64546563683230323644656d6f5365656421

# Fraud Rules Engine Configuration
RAPID_RESALE_DAYS=30

# Frontend Public URL for QR Verification Links
PUBLIC_VERIFY_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
