APP_NAME="BhumiShield (ভূমি সুরক্ষা)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=sqlite
DB_DATABASE=/tmp/bhumishield_full_project/backend/database/database.sqlite

# Optional PostgreSQL config for Docker Compose:
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=bhumishield
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

JWT_SECRET=landtech-hackathon-2026-bhumishield-secret-key
VITE_API_URL=http://127.0.0.1:8000/api/v1
PUBLIC_VERIFY_BASE_URL=http://localhost:5175

# Reviewed public-source collector (absolute Python 3 executable, no shell arguments).
SOURCE_COLLECTOR_PYTHON=/usr/bin/python3
# Worker: php tools/service_sources/worker.php --watch --limit=2
# Package tools/service_sources beside backend, or use tools/service_sources/Dockerfile.
